            "text": "{\"query\":\"\\n    query issueViewRemoteConfluenceWhiteboardQuery($id: ID!) {\\n        graphStore @optIn(to: \\\"GraphStore\\\") {\\n            issueToWhiteboard (id: $id first: 900) @optIn(to: \\\"GraphStoreIssueToWhiteboard\\\") {\\n                edges {\\n                    node {\\n                        ... on ConfluenceWhiteboard {\\n                            id\\n                            links {\\n                                base\\n                                webUi\\n                            }\\n                            author {\\n                                user {\\n                                accountId\\n                                accountStatus\\n                                name\\n                                picture\\n                                }\\n                            }\\n                            title\\n                            whiteboardId\\n                        }\\n                    }\\n                }\\n                totalCount\\n            }\\n        }\\n    }\\n\",\"variables\":{\"id\":\"ari:cloud:jira:5a9b1bda-c55f-41e6-8d1b-98f210cdef5d:issue/10000\"}}"
