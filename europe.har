            "text": "{\"query\":\"query jira_forge_frontendModules($contextIds: [ID!]! $extensionsFilter: [ExtensionContextsFilter!]! $dataClassificationTags: [ID!]!, $locale: String) {\\n        extensionContexts(contextIds: $contextIds) @optIn(to: \\\"Access-Narrowing\\\") {\\n            extensions(filter: $extensionsFilter, locale: $locale) {\\n                id\\n                appVersion\\n                installationId\\n                environmentId\\n                environmentType\\n                environmentKey\\n                properties\\n                \\n    license {\\n        active\\n        type\\n        supportEntitlementNumber\\n        trialEndDate\\n        subscriptionEndDate\\n        isEvaluation\\n        billingPeriod\\n        ccpEntitlementId\\n        ccpEntitlementSlug\\n\\t\\t    capabilitySet\\n    }\\n                \\n                type\\n                __typename\\n                \\n    consentUrl\\n    currentUserConsent {\\n        user {\\n            aaid\\n        }\\n        appEnvironmentVersion {\\n            id\\n        }\\n        consentedAt\\n    }\\n    requiresUserConsent\\n                egress {\\n                    type\\n                    addresses\\n                }\\n                dataClassificationPolicyDecision(input: {\\n                    dataClassificationTags: $dataClassificationTags\\n                }) {\\n                    status\\n                }\\n            }\\n        }\\n    }\",\"variables\":{\"contextIds\":[\"ari:cloud:jira:5a9b1bda-c55f-41e6-8d1b-98f210cdef5d:workspace/100a3433-1513-450d-a8c1-b6b58b564d69\"],\"extensionsFilter\":[{\"type\":\"EXTENSION_TYPE\",\"value\":[\"jira:globalPage\"]}],\"dataClassificationTags\":[],\"locale\":\"en_US\"}}"
